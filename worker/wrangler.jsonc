{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-transcript-worker",
  "main": "src/main.py",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true
  },
  // Cache opcional de transcripts (gratis, reduce peticiones repetidas
  // a YouTube). Crea el namespace con:
  //   npx wrangler kv namespace create TRANSCRIPT_CACHE
  // y descomenta la linea de abajo con el "id" que te devuelva:
  // "kv_namespaces": [{ "binding": "TRANSCRIPT_CACHE", "id": "TU_ID_AQUI" }]
}